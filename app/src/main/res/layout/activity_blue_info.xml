<?xml version="1.0" encoding="utf-8"?><FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#101114">

<!-- MAVI KURT ARKA PLANI -->
<ImageView
    android:id="@+id/bluePageBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/wolf_blue"
    android:scaleType="fitCenter"
    android:contentDescription="Mavi kurt temalı arka plan" />

<!-- SAYFA BUTONLARI -->
<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="80dp"
        android:paddingBottom="90dp">

        <!-- EN YAKIN SAGLIK KURULUSU -->
        <ImageView
            android:id="@+id/blueButton1"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="170dp"
            android:src="@drawable/blue_button_1"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="En yakın sağlık kuruluşu" />

        <!-- EN YAKIN KOLLUK KUVVETI -->
        <ImageView
            android:id="@+id/blueButton2"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/blue_button_2"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="En yakın kolluk kuvveti" />

        <!-- EN YAKIN ECZANE -->
        <ImageView
            android:id="@+id/blueButton3"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/blue_button_3"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="En yakın eczane" />

    </LinearLayout>
</ScrollView>

<!-- UST EMERGENCY SERIDI -->
<TextView
    android:id="@+id/stripEmergency"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="top"
    android:background="#ad0002"
    android:gravity="center"
    android:text="EMERGENCY"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:fontFamily="sans-serif-condensed"
    android:textStyle="bold"
    android:letterSpacing="0.12"
    android:shadowColor="#99000000"
    android:shadowDx="1"
    android:shadowDy="2"
    android:shadowRadius="3" />

<!-- ALT SAFETY SERIDI -->
<TextView
    android:id="@+id/stripSafety"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom"
    android:background="#03087b"
    android:gravity="center"
    android:text="SAFETY"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:fontFamily="sans-serif-condensed"
    android:textStyle="bold"
    android:letterSpacing="0.16"
    android:shadowColor="#99000000"
    android:shadowDx="1"
    android:shadowDy="2"
    android:shadowRadius="3" />

</FrameLayout>
