<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <!-- MAVI KURT ARKA PLANI -->
    <ImageView
        android:id="@+id/bluePageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wolf_blue"
        android:scaleType="fitCenter"
        android:contentDescription="Mavi kurt temalı arka plan" />

    <!-- SAYFA BUTONLARI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="90dp">

            <!-- EN YAKIN SAGLIK KURULUSU -->
            <ImageView
                android:id="@+id/blueButton1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="170dp"
                android:src="@drawable/blue_button_1"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın sağlık kuruluşu" />

            <!-- EN YAKIN KOLLUK KUVVETI -->
            <ImageView
                android:id="@+id/blueButton2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/blue_button_2"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın kolluk kuvveti" />

            <!-- EN YAKIN ECZANE -->
            <ImageView
                android:id="@+id/blueButton3"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/blue_button_3"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın eczane" />

        </LinearLayout>
    </ScrollView>

    <!-- UST BANNER -->
    <ImageView
        android:id="@+id/stripEmergency"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:src="@drawable/banner_1"
        android:scaleType="fitXY"
        android:contentDescription="Emergency banner" />

    <!-- ALT BANNER -->
    <ImageView
        android:id="@+id/stripSafety"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:src="@drawable/banner_2"
        android:scaleType="fitXY"
        android:contentDescription="Safety banner" />

</FrameLayout>
