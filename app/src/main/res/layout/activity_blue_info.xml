<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <!-- MAVİ KURT ARKA PLANI -->
    <ImageView
        android:id="@+id/bluePageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wolf_blue"
        android:scaleType="fitCenter"
        android:contentDescription="Mavi kurt temalı arka plan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- SAYFA BAŞLIĞI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="MAVİ GÜVENLİK"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:shadowColor="#49B6FF"
                android:shadowRadius="10" />

            <!-- EN YAKIN SAĞLIK KURULUŞU -->
            <ImageView
                android:id="@+id/blueButton1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="250dp"
                android:src="@drawable/blue_button_1"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın sağlık kuruluşu" />

            <!-- EN YAKIN KOLLUK KUVVETİ -->
            <ImageView
                android:id="@+id/blueButton2"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/blue_button_2"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın kolluk kuvveti" />

            <!-- EN YAKIN ECZANE -->
            <ImageView
                android:id="@+id/blueButton3"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/blue_button_3"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="En yakın eczane" />

            <!-- ALT YAZI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Emergency Safety"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
