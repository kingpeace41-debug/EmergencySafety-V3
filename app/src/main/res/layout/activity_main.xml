<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <LinearLayout
        android:id="@+id/backgroundDesign"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/stripEmergency"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:src="@drawable/banner_1"
            android:scaleType="fitXY"
            android:contentDescription="Emergency banner" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#101114">

            <ImageView
                android:id="@+id/wolfBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wolf_passive"
                android:scaleType="fitCenter"
                android:contentDescription="Emergency Safety kurt arka planı" />

        </FrameLayout>

        <ImageView
            android:id="@+id/stripSafety"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:src="@drawable/banner_2"
            android:scaleType="fitXY"
            android:contentDescription="Safety banner" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/wolfTouchArea"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Dinlemeyi aç veya kapat" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:background="@android:color/transparent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <FrameLayout
                    android:id="@+id/btnRedAlert"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Acil durum">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/button_red"
                        android:scaleType="fitCenter"
                        android:contentDescription="Kırmızı acil durum butonu"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnYellowAlert"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Uyarı">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/button_yellow"
                        android:scaleType="fitCenter"
                        android:contentDescription="Sarı uyarı butonu"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnGreenAlert"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bilgi">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/button_blue"
                        android:scaleType="fitCenter"
                        android:contentDescription="Mavi bilgi butonu"
                        android:importantForAccessibility="no" />

                </FrameLayout>

            </LinearLayout>

            <!-- Acil durum hazirlik paneli: durumlar MainActivity tarafindan guncellenecek. -->
            <LinearLayout
                android:id="@+id/emergencyReadinessPanel"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="26dp"
                android:paddingBottom="18dp"
                android:background="@drawable/hazirlik_konsolu"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Acil durum hazirlik durumunu kontrol et">

                <TextView
                    android:id="@+id/readinessTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="◇  GÜVENLİK KONTROLÜ  ◇"
                    android:textColor="#D9E5F3"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/readinessMicrophone"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_marginEnd="0dp"
                        android:text="● Ses"
                        android:textColor="#AEBBCD"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/readinessLocation"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_marginEnd="0dp"
                        android:text="● Konum"
                        android:textColor="#AEBBCD"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/readinessConnection"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="● Bağlantı"
                        android:textColor="#AEBBCD"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/btnToggleListening"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F2F4F7"
                app:cardCornerRadius="27dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Dinleme düğmesi"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="#222222" />

            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </ScrollView>

    <!-- Gelen acil durum mesajı için alarm butonu.
         Normal durumda görünmez.
         MainActivity tarafından etkinleştirilecektir. -->

    <FrameLayout
        android:id="@+id/emergencyAlertOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="135dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnIncomingEmergency"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:gravity="center"
            android:text="🚨 ACİL DURUM MESAJI 🚨&#10;GÖRMEK İÇİN DOKUN"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="#B91C2B"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Gelen acil durum mesajını aç" />

    </FrameLayout>

</FrameLayout>
