<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080F1D"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="EMERGENCY SAFETY"
            android:textColor="#F4F7FC"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Gümüş dış çerçeve -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#B8C3D1"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- Lacivert iç çerçeve -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#263B50"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/authWolfImage"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:contentDescription="EmergencySafety kurt görseli"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wolf_splash" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Güvenliğin için buradayız"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hesabına giriş yap veya yeni bir hesap oluştur."
            android:textColor="#AAB7CA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#121E30"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-posta adresi"
                android:textColor="#EAF0FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/authEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:backgroundTint="#52749F"
                android:hint="ornek@email.com"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8191A8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Şifre"
                android:textColor="#EAF0FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/authPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:backgroundTint="#52749F"
                android:hint="Şifrenizi girin"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8191A8" />

            <Button
                android:id="@+id/btnAuthLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#246BCE"
                android:text="GİRİŞ YAP"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAuthRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="YENİ HESAP OLUŞTUR"
                android:textColor="#75B5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAuthForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="Şifremi unuttum"
                android:textColor="#AAB7CA"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="VEYA"
            android:textColor="#66758B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAuthContinueWithoutAccount"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#263B50"
            android:text="HESAPSIZ DEVAM ET"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Acil durum ve güvenlik özelliklerini kullanabilirsin. Bireysel mesajlaşma için hesap gerekir."
            android:textColor="#AAB7CA"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="EmergencySafety • Güvenli iletişim"
            android:textColor="#66758B"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
