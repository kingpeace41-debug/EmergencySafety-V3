<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#080F1D"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- KURT GÖRSELİ: HESAP PANELİYLE AYNI GENİŞLİK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#B8C3D1"
        android:elevation="8dp"
        android:padding="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#263B50"
            android:padding="2dp">

            <ImageView
                android:id="@+id/authWolfImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/wolf_splash"
                android:scaleType="fitCenter"
                android:contentDescription="EmergencySafety kurt görseli" />

        </LinearLayout>
    </LinearLayout>

    <!-- HESAP BİLGİLERİ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#121E30"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-posta"
            android:textColor="#EAF0FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/authEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:autofillHints="emailAddress"
            android:backgroundTint="#52749F"
            android:hint="ornek@email.com"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8191A8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Şifre"
            android:textColor="#EAF0FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/authPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:autofillHints="password"
            android:backgroundTint="#52749F"
            android:hint="Şifrenizi girin"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8191A8" />

        <Button
            android:id="@+id/btnAuthLogin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#246BCE"
            android:text="GİRİŞ YAP"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAuthRegister"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="YENİ HESAP OLUŞTUR"
            android:textColor="#75B5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAuthForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="Şifremi unuttum"
            android:textColor="#AAB7CA"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- HESAPSIZ DEVAM -->
    <Button
        android:id="@+id/btnAuthContinueWithoutAccount"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#263B50"
        android:text="HESAPSIZ DEVAM ET"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
