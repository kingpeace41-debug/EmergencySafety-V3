<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_red_gradient"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="18dp"
        android:text="REHBER VE MESAJ AYARLARI"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="ACİL DURUM KİŞİLERİ"
        android:textColor="#FF7777"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContact1Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF7777"
        android:hint="1. acil durum kişisini seçin"
        android:inputType="textCapSentences"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC" />

    <EditText
        android:id="@+id/etContact1Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="1. kişi telefon numarası"
        android:inputType="phone"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etContact2Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF7777"
        android:hint="2. acil durum kişisini seçin"
        android:inputType="textCapSentences"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC" />

    <EditText
        android:id="@+id/etContact2Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2. kişi telefon numarası"
        android:inputType="phone"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etContact3Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#FF7777"
        android:hint="3. acil durum kişisini seçin"
        android:inputType="textCapSentences"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC" />

    <EditText
        android:id="@+id/etContact3Phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="3. kişi telefon numarası"
        android:inputType="phone"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="ACİL DURUM MESAJI"
        android:textColor="#FF7777"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEmergencyMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="Gönderilecek acil durum mesajını yazın"
        android:inputType="textMultiLine|textCapSentences"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:backgroundTint="#FF7777"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCCCCC" />

    <Button
        android:id="@+id/btnSaveContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#D32F2F"
        android:text="KAYDET"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnBackContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="#424242"
        android:text="GERİ DÖN"
        android:textColor="#FFFFFF" />

</LinearLayout>
