<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <ImageView
        android:id="@+id/redPageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wolf_red"
        android:scaleType="fitCenter"
        android:contentDescription="Kırmızı kurt temalı arka plan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="90dp">

            <ImageView
                android:id="@+id/btnContactMessageSettings"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="170dp"
                android:src="@drawable/red_button_1"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Rehber ve mesaj ayarları" />

            <ImageView
                android:id="@+id/btnVoiceCommandSettings"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/red_button_2"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Sesli komut ayarları" />

            <ImageView
                android:id="@+id/btnManualEmergencyProtocol"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/red_button_3"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Manuel acil durum protokolünü başlat" />

        </LinearLayout>
    </ScrollView>

    <!-- ÜST BANNER -->
    <ImageView
        android:id="@+id/stripEmergency"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:src="@drawable/banner_1"
        android:scaleType="fitXY"
        android:contentDescription="Emergency banner" />

    <!-- ALT BANNER -->
    <ImageView
        android:id="@+id/stripSafety"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:src="@drawable/banner_2"
        android:scaleType="fitXY"
        android:contentDescription="Safety banner" />

</FrameLayout>
