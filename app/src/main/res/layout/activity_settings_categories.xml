<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#101114">

<ImageView
    android:id="@+id/redPageBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/wolf_red"
    android:scaleType="fitCenter"
    android:contentDescription="Kırmızı kurt temalı arka plan" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="80dp"
        android:paddingBottom="90dp">

        <ImageView
            android:id="@+id/btnContactMessageSettings"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="170dp"
            android:src="@drawable/red_button_1"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Rehber ve mesaj ayarları" />

        <ImageView
            android:id="@+id/btnVoiceCommandSettings"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/red_button_2"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Sesli komut ayarları" />

        <ImageView
            android:id="@+id/btnManualEmergencyProtocol"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/red_button_3"
            android:scaleType="fitCenter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Manuel acil durum protokolünü başlat" />

    </LinearLayout>
</ScrollView>

<TextView
    android:id="@+id/stripEmergency"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="top"
    android:background="#ad0002"
    android:gravity="center"
    android:text="EMERGENCY"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:fontFamily="sans-serif-condensed"
    android:textStyle="bold"
    android:letterSpacing="0.12"
    android:shadowColor="#FF7777"
    android:shadowDx="0"
    android:shadowDy="2"
    android:shadowRadius="5"
    android:elevation="8dp" />

<TextView
    android:id="@+id/stripSafety"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom"
    android:background="#03087b"
    android:gravity="center"
    android:text="SAFETY"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:fontFamily="sans-serif-condensed"
    android:textStyle="bold"
    android:letterSpacing="0.16"
    android:shadowColor="#8A9CFF"
    android:shadowDx="0"
    android:shadowDy="2"
    android:shadowRadius="5"
    android:elevation="8dp" />

</FrameLayout>
