<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <ImageView
        android:id="@+id/yellowPageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wolf_yellow"
        android:scaleType="fitCenter"
        android:contentDescription="Sarı kurt temalı arka plan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="SARI GÜVENLİK"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:shadowColor="#FFD34D"
                android:shadowRadius="10" />

            <ImageView
                android:id="@+id/btnYellowHelp"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="250dp"
                android:src="@drawable/yellow_button_1"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Yardım iste" />

            <ImageView
                android:id="@+id/btnYellowLocation"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/yellow_button_2"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Konumumu paylaş" />

            <ImageView
                android:id="@+id/btnYellowSafetySupport"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/yellow_button_3"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Güvenlik desteği" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="Emergency Safety"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
