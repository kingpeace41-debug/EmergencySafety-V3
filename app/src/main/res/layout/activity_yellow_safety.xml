<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <!-- SARI KURT ARKA PLANI -->
    <ImageView
        android:id="@+id/yellowPageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wolf_yellow"
        android:scaleType="fitCenter"
        android:alpha="0.22"
        android:contentDescription="Sarı kurt arka planı" />

    <!-- YENİ MESAJLAŞMA PANELİ -->
    <FrameLayout
        android:id="@+id/messagePanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="60dp"
        android:padding="12dp" />

    <!-- ÜST BANNER -->
    <ImageView
        android:id="@+id/stripEmergency"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:src="@drawable/banner_1"
        android:scaleType="fitXY"
        android:contentDescription="Emergency banner" />

    <!-- ALT BANNER -->
    <ImageView
        android:id="@+id/stripSafety"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:src="@drawable/banner_2"
        android:scaleType="fitXY"
        android:contentDescription="Safety banner" />

</FrameLayout>
