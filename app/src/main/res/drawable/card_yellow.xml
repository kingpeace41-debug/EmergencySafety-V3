<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. Arka Plan Koyu Dış Çerçeve ve Gölge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D2B00" />
            <corners android:radius="27dp" />
        </shape>
    </item>

    <!-- 2. Ana Sarı Gövde -->
    <item 
        android:left="1.5dp" 
        android:top="1.5dp" 
        android:right="1.5dp" 
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient 
                android:type="linear" 
                android:angle="270" 
                android:startColor="#FFD700" 
                android:centerColor="#FF9900" 
                android:endColor="#995C00" />
            <corners android:radius="25dp" />
            <stroke 
                android:width="1.5dp" 
                android:color="#FFE580" />
        </shape>
    </item>

    <!-- 3. Gerçek Cam/Jel Parlaması (Üst Alan) -->
    <item 
        android:left="5dp" 
        android:top="4dp" 
        android:right="5dp" 
        android:bottom="32dp">
        <shape android:shape="rectangle">
            <gradient 
                android:type="linear" 
                android:angle="270" 
                android:startColor="#E6FFFFFF" 
                android:centerColor="#55FFFFFF" 
                android:endColor="#00FFFFFF" />
            <corners 
                android:topLeftRadius="21dp" 
                android:topRightRadius="21dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>

    <!-- 4. Alt Kenar Vurgu Yansıması -->
    <item 
        android:left="15dp" 
        android:top="42dp" 
        android:right="15dp" 
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient 
                android:type="linear" 
                android:angle="90" 
                android:startColor="#66FFEAA6" 
                android:endColor="#00FFEAA6" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</layer-list>
